# ---------------------------------------------------------------------------
# Cosmic Return Navigator - backend environment
# Copy to `.env` and adjust locally. Every value has a safe demo default.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Demo determinism
# ---------------------------------------------------------------------------
# The demo narrative depends on "bought a smartwatch 20 days ago". Freezing the
# clock keeps every date calculation (return windows, SLAs, pickup slots)
# reproducible no matter when the demo is run.
# Set DEMO_FREEZE_CLOCK=false to use the real system clock.
DEMO_FREEZE_CLOCK=true
DEMO_NOW=2026-09-08T10:15:00.000Z

# ---------------------------------------------------------------------------
# Agent simulation
# ---------------------------------------------------------------------------
# Artificial per-agent latency (ms) so the frontend can visibly animate the
# "running -> complete" agent pipeline. Set both to 0 for fast tests.
AGENT_SIMULATED_LATENCY_MIN_MS=350
AGENT_SIMULATED_LATENCY_MAX_MS=900

# Hard timeout per agent. Exceeding it produces an AGENT_TIMEOUT escalation.
AGENT_TIMEOUT_MS=8000

# Resolutions above this value require human approval instead of auto-approval.
AUTO_APPROVE_MAX_USD=500

# ---------------------------------------------------------------------------
# Claude Agent SDK  (agent implementations)
# ---------------------------------------------------------------------------
# rules  = deterministic TypeScript. No network, no cost, instant, reproducible.
#          This is what the test suite runs against.
# llm    = all seven agents are Claude Agent SDK calls with a FORCED JSON schema.
# hybrid = LLM for LLM_AGENTS below, rules for the rest. Recommended for the demo.
AGENT_RUNTIME=hybrid

# Which agents use the LLM when AGENT_RUNTIME=hybrid ('all' or a CSV of ids:
# eligibility,sentiment,resolution,logistics,communication,sustainability,insights)
#
# The default deliberately excludes eligibility, logistics and sustainability:
# those are policy citation and arithmetic, where deterministic rules are both
# more accurate and more defensible in an audit. The four below are language
# understanding and synthesis, where the model genuinely wins.
LLM_AGENTS=sentiment,resolution,communication,insights

# If an LLM agent fails (no key, no network, schema violation after repair),
# fall back to its rules implementation instead of failing the case.
# Strongly recommended for a live demo.
LLM_FALLBACK_TO_RULES=true

# --- credentials: paste your own values, never commit real ones -------------
#
# PICK EXACTLY ONE. Which you need depends on the endpoint:
#
#   ANTHROPIC_API_KEY     -> sent as `x-api-key`.
#                            Use for the first-party Anthropic API (sk-ant-...).
#   ANTHROPIC_AUTH_TOKEN  -> sent as `Authorization: Bearer`.
#                            Use for third-party gateways and classroom proxies
#                            (Vocareum, LiteLLM, and similar).
#
# GOTCHA WORTH KNOWING: a gateway that wants Bearer will reject an x-api-key
# request with `400 This key was not found. Please check key was inputed
# correctly.` That reads like a bad credential but is really the wrong header —
# if you see it, move the value to ANTHROPIC_AUTH_TOKEN. If both are set, the
# Bearer token wins and the API key is not forwarded.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# Optional gateway / proxy. Leave blank for the default Anthropic endpoint.
ANTHROPIC_BASE_URL=

# --- model + spend controls -------------------------------------------------
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max. These agents reason over supplied JSON,
# so 'low' is usually plenty and keeps the pipeline demo-fast.
LLM_EFFORT=low
# Turn budget per agent call. Do NOT set this to 1: emitting the forced
# structured output consumes a turn, so 1 makes every call die with
# 'error_max_turns' before it can answer.
LLM_MAX_TURNS=6
LLM_TIMEOUT_MS=120000
# Re-asks once with the Zod validation errors appended if the JSON is invalid.
LLM_MAX_REPAIR_ATTEMPTS=1
# Hard USD ceiling per agent call. 0 = disabled.
LLM_MAX_BUDGET_USD=0
